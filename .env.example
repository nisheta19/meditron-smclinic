# Скопируй в .env: cp .env.example .env
POSTGRES_DB=meditron
POSTGRES_USER=meditron
POSTGRES_PASSWORD=meditron
POSTGRES_PORT=5432

BACKEND_PORT=8080
ML_PORT=8000
FRONTEND_PORT=3000

# Единственный тестовый аккаунт для формы входа.
AUTH_LOGIN=123
AUTH_PASSWORD=123
AUTH_REQUIRED=true
AUTH_COOKIE_SECURE=false

# Маршруты работают по умолчанию; перемотка времени и сценарии — только в отдельной демо-БД.
ROUTES_ENABLED=true
ROUTES_SIM_ENABLED=false
